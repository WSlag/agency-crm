rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return request.auth.token.role == role;
    }
    
    function belongsToBranch(branchId) {
      return request.auth.token.branchId == branchId;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isPresident() {
      return hasRole('president');
    }
    
    function isBranchManager() {
      return hasRole('branch_manager');
    }
    
    function isHORecruitmentOfficer() {
      return hasRole('ho_recruitment_officer');
    }
    
    function isHOAccountant() {
      return hasRole('ho_accountant');
    }
    
    function isValidFileSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }
    
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocumentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
             request.resource.contentType.matches('application/vnd.ms-excel') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }
    
    // ==========================================
    // APPLICANT DOCUMENTS
    // ==========================================
    
    match /documents/{applicantId}/{documentId} {
      allow read: if isAuthenticated();
      
      allow write: if isAuthenticated() &&
        isValidFileSize(10) &&
        isValidDocumentType() &&
        (isAdmin() ||
         isHORecruitmentOfficer() ||
         isBranchManager());
      
      allow delete: if isAdmin();
    }
    
    // Legacy path for applicant documents
    match /applicants/{applicantId}/{document=**} {
      allow read: if isAuthenticated() &&
        (isAdmin() ||
         isPresident() ||
         isHORecruitmentOfficer() ||
         isBranchManager());
      
      allow write: if isAuthenticated() &&
        isValidFileSize(10) &&
        isValidDocumentType() &&
        (isAdmin() ||
         isHORecruitmentOfficer() ||
         isBranchManager());
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // RECEIPTS (Branch-specific)
    // ==========================================
    
    match /receipts/{branchId}/{receiptId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isPresident() ||
        isHOAccountant() ||
        belongsToBranch(branchId)
      );
      
      allow write: if isAuthenticated() &&
        isValidFileSize(5) &&
        isValidDocumentType() &&
        (isAdmin() ||
         isHOAccountant() ||
         (isBranchManager() && belongsToBranch(branchId)));
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // PROFILE PICTURES
    // ==========================================
    
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidFileSize(2) &&
        isValidImageType();
      
      allow delete: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
    }
    
    // ==========================================
    // EXPENSE RECEIPTS
    // ==========================================
    
    match /expense_receipts/{expenseId}/{receiptId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isPresident() ||
        isHOAccountant()
      );
      
      allow write: if isAuthenticated() &&
        isValidFileSize(5) &&
        isValidDocumentType() &&
        (isAdmin() ||
         isHOAccountant() ||
         isBranchManager());
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // REPORTS (Generated reports)
    // ==========================================
    
    match /reports/{reportId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isPresident() ||
        isBranchManager() ||
        isHOAccountant()
      );
      
      allow write: if isAuthenticated() &&
        isValidFileSize(20) &&
        (isAdmin() || isPresident() || isBranchManager());
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // PUBLIC ASSETS
    // ==========================================
    
    match /public/{document=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize(10);
    }
    
    // ==========================================
    // COMPANY DOCUMENTS (HR, Policies, etc.)
    // ==========================================
    
    match /company_documents/{category}/{documentId} {
      allow read: if isAuthenticated();
      
      allow write: if isAdmin() &&
        isValidFileSize(20) &&
        isValidDocumentType();
      
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // TEMP UPLOADS (7 days auto-delete)
    // ==========================================
    
    match /temp/{userId}/{fileName} {
      allow read, write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidFileSize(10);
    }
  }
}
