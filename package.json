{
  "name": "agency-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "migrate:claims": "tsx src/migrations/run-migration.ts",
    "migrate:rules": "firebase deploy --only firestore:rules,storage:rules",
    "migrate:backup": "firebase firestore:export ./backup/firestore",
    "migrate:rollback": "tsx src/migrations/rollback.ts",
    "migrate:stage-fields": "tsx src/migrations/init-stage-fields.ts",
    "fix:applicant-rejection": "tsx src/scripts/fixApplicantRejection.ts",
    "fix:verify-documents": "tsx src/scripts/verifyPendingDocuments.ts",
    "check:document-expiry": "tsx src/scripts/checkDocumentExpiry.ts",
    "init-db": "tsx src/scripts/runInitialization.ts",
    "dev": "vite --mode development",
    "build:staging": "tsc && vite build --mode staging",
    "build:prod": "tsc && vite build --mode production",
    "preview:staging": "vite preview --mode staging",
    "preview:prod": "vite preview --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.2",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@sentry/react": "^7.0.0",
    "date-fns": "^4.1.0",
    "firebase": "^9.0.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.23.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.18.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/tailwindcss": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^0.16.7"
  }
}
