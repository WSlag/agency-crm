# ==========================================
# Agency CRM - Environment Template
# ==========================================
# Copy this file to .env.development / .env.staging / .env.production
# and fill in your REAL values. NEVER commit real .env files.
#
# NOTE: As of this writing the previous Firebase project credentials
# (crm-agency-22f30) were ROTATED. The old API key and service account
# key are INVALID. Obtain fresh values from:
#   Firebase Console > Project Settings > General
#   Firebase Console > Project Settings > Cloud Messaging

# ==========================================
# Firebase Configuration (Required)
# ==========================================
VITE_FIREBASE_API_KEY=your_new_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging VAPID key (Project Settings > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# ==========================================
# Environment Settings
# ==========================================
VITE_APP_ENV=development
VITE_APP_NAME=Agency CRM
VITE_APP_URL=http://localhost:5173
VITE_STORAGE_PREFIX=agency_crm_
VITE_LOG_LEVEL=debug

# ==========================================
# Sentry Configuration (Optional)
# ==========================================
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ==========================================
# Feature Flags
# ==========================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_NOTIFICATIONS=true

# ==========================================
# Firebase Performance Settings
# ==========================================
VITE_FIRESTORE_CACHE_SIZE_MB=50
VITE_STORAGE_MAX_UPLOAD_SIZE_MB=10
VITE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ==========================================
# Security Settings
# ==========================================
VITE_MAX_FILE_SIZE_MB=10
VITE_MAX_FILES_PER_UPLOAD=5
VITE_ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx

# ==========================================
# Rate Limiting
# ==========================================
VITE_API_RATE_LIMIT=100
VITE_API_RATE_LIMIT_WINDOW=60000

# ==========================================
# Cache Settings
# ==========================================
VITE_CACHE_TTL=3600
VITE_STATIC_CACHE_VERSION=1

# ==========================================
# Firebase Emulators (local development only)
# ==========================================
VITE_USE_EMULATORS=false
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_AUTH_EMULATOR_HOST=localhost:9099
VITE_STORAGE_EMULATOR_HOST=localhost:9199
VITE_FUNCTIONS_EMULATOR_HOST=localhost:5001
