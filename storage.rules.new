rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return request.auth.token.role == role;
    }
    
    function belongsToBranch(branchId) {
      return request.auth.token.branchId == branchId;
    }
    
    function isValidFileSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }
    
    function isValidContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
    
    // Applicant documents
    match /applicants/{applicantId}/{document=**} {
      allow read: if isAuthenticated() &&
        (hasRole('admin') ||
         hasRole('president') ||
         hasRole('ho_recruitment_officer') ||
         (hasRole('branch_manager') && belongsToBranch(resource.metadata.branchId)));
      
      allow write: if isAuthenticated() &&
        isValidFileSize() &&
        isValidContentType() &&
        (hasRole('admin') ||
         hasRole('ho_recruitment_officer') ||
         (hasRole('branch_manager') && belongsToBranch(resource.metadata.branchId)));
    }
    
    // Profile pictures
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isValidFileSize() &&
        request.resource.contentType.matches('image/.*');
    }
    
    // Public assets
    match /public/{document=**} {
      allow read: if true;
      allow write: if hasRole('admin');
    }
  }
}
